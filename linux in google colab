        "        \"-display\", \"none\",\n",
        "        \"-vnc\", \"127.0.0.1:0\",\n",
        "        \"-drive\", f\"file={storage_path},if=virtio,format=qcow2\",\n",
        "        \"-sandbox\", \"off\",\n",
        "        \"-machine\", \"type=pc,accel=kvm:tcg\"\n",
        "    ]\n",
        "\n",
        "    if uefi_bios_path:\n",
        "        qemu_cmd.extend([\"-bios\", uefi_bios_path])\n",
