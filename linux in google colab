        "        print(\"=\"*50 + \"\\n\")\n",
        "\n",
        "\n",
        "\n",
        "def send_string_to_vm(text_string):\n",
        "    \"\"\"Sends keystrokes to the running QEMU instance via its local UNIX socket.\"\"\"\n",
        "    socket_path = \"/tmp/qemu-monitor.sock\"\n",
        "\n",
        "    if not os.path.exists(socket_path):\n",
        "        print(f\"❌ Error: Monitor socket not found at {socket_path}. Is the VM cell running?\")\n",
        "        return\n",
        "\n",
        "    # Character-to-QEMU-keyname mapping overrides\n",
        "    key_map = {\n",
        "        ' ': 'spc', '.': 'dot', ',': 'comma', '-': 'minus', '=': 'equal',\n",
        "        '/': 'slash', '\\n': 'ret', '\\t': 'tab', '_': 'shift-minus',\n",
        "        ':': 'shift-semicolon', '\"': 'shift-apostrophe'\n",
        "    }\n",
        "\n",
        "    try:\n",
        "        # Establish connection to the local control socket file\n",
        "        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n",
        "        s.connect(socket_path)\n",
        "        s.recv(1024)  # Clear the introductory QEMU monitor banner text\n",
        "\n",
        "        for char in text_string:\n",
        "            if char.isupper():\n",
        "                cmd = f\"sendkey shift-{char.lower()}\\n\"\n",
        "            elif char in key_map:\n",
        "                cmd = f\"sendkey {key_map[char]}\\n\"\n",
        "            else:\n",
        "                cmd = f\"sendkey {char}\\n\"\n",
        "\n",
        "            s.sendall(cmd.encode())\n",
        "            s.recv(1024)      # Await confirmation back from the monitor bridge\n",
        "            time.sleep(0.05)  # Short pause to prevent the VM from dropping characters\n",
        "\n",
        "        s.close()\n",
        "    except Exception as e:\n",
        "        print(f\"Monitor socket mapping error: {e}\")\n"
