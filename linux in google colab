        "    subprocess.Popen([\"websockify\", \"--web=/usr/share/novnc\", \"6080\", \"localhost:5900\"],\n",
        "                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
        "    time.sleep(3) # Expanded buffer for slower cloud runtimes\n",
        "\n",
        "    print(\"\\n=== STEP 4: RUNNING QEMU ENGINE WITH LOCAL MONITOR CONTROL ===\")\n",
        "    qemu_cmd = [\n",
        "        \"qemu-system-x86_64\",\n",
        "        \"-m\", \"4G\",\n",
        "        \"-smp\", \"4,sockets=1,cores=4\",\n",
        "        \"-cpu\", \"max\",\n",
        "        \"-vga\", \"std\",\n",
        "        \"-display\", \"none\",\n",
        "\n",
        "        # --- THE PORT INDEX FIX: :0 accurately binds QEMU to port 5900 ---\n",
        "        \"-vnc\", \"127.0.0.1:0\",\n",
        "\n",
        "        \"-cdrom\", iso_path,\n",
