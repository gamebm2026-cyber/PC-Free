        "import os\n",
        "import glob\n",
        "import subprocess\n",
        "import time\n",
        "import socket\n",
        "from google.colab import output\n",
        "\n",
        "# Helper function to send commands to the VM via UNIX socket\n",
        "def send_string_to_vm(text_string):\n",
        "    socket_path = \"/tmp/qemu-monitor.sock\"\n",
        "    if not os.path.exists(socket_path):\n",
        "        return\n",
        "    key_map = {' ': 'spc', '.': 'dot', ',': 'comma', '-': 'minus', '=': 'equal',\n",
        "               '/': 'slash', '\\n': 'ret', '\\t': 'tab', '_': 'shift-minus',\n",
        "               ':': 'shift-semicolon', '\"': 'shift-apostrophe'}\n",
        "    try:\n",
        "        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n",
        "        s.connect(socket_path)\n",
        "        s.recv(1024)\n",
        "        for char in text_string:\n",
        "            if char.isupper(): cmd = f\"sendkey shift-{char.lower()}\\n\"\n",
        "            elif char in key_map: cmd = f\"sendkey {key_map[char]}\\n\"\n",
        "            else: cmd = f\"sendkey {char}\\n\"\n",
        "            s.sendall(cmd.encode())\n",
        "            s.recv(1024)\n",
        "            time.sleep(0.04)\n",
        "        s.close()\n",
        "    except:\n",
        "        pass\n",
        "\n",
        "print(\"=== STEP 1: SHUTTING DOWN VM FOR HARDWARE UPGRADE ===\")\n",
        "!pkill -9 -f qemu\n",
        "!pkill -9 -f websockify\n",
        "time.sleep(2)\n",
        "\n",
        "print(\"\\n=== STEP 2: DYNAMICALLY LOCATING VIRTUAL DISK ===\")\n",
        "preferred_path = \"/content/arch_target.qcow2\"\n",
        "fallback_path = \"arch-desktop-flatpak-vbox-2026.03.01-x64.qcow2\"\n",
        "storage_path = \"\"\n",
        "\n",
        "if os.path.exists(preferred_path): storage_path = preferred_path\n",
        "elif os.path.exists(fallback_path): storage_path = fallback_path\n",
        "else:\n",
        "    qcow2_files = glob.glob(\"**/*.qcow2\", recursive=True) + glob.glob(\"*.qcow2\")\n",
        "    if qcow2_files: storage_path = qcow2_files[0]\n",
        "\n",
        "if not storage_path:\n",
        "    print(\"❌ Error: No .qcow2 file found!\")\n",
        "else:\n",
        "    print(f\"✅ Found disk file: {storage_path}\")\n",
        "\n",
        "    print(\"\\n=== STEP 3: RESIZING VIRTUAL DISK FILE BY +10 GB ===\")\n",
        "    # Use host utility to append raw storage size to the image structure\n",
        "    os.system(f\"qemu-img resize {storage_path} +10G\")\n",
        "\n",
        "    print(\"\\n=== STEP 4: REBOOTING THE ACCELERATED VM ENGINE ===\")\n",
        "    subprocess.Popen([\"websockify\", \"--web=/usr/share/novnc\", \"6080\", \"127.0.0.1:5900\"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
        "\n",
        "    qemu_cmd = [\n",
        "        \"qemu-system-x86_64\", \"-m\", \"4G\", \"-smp\", \"4,sockets=1,cores=4\", \"-cpu\", \"max\",\n",
        "        \"-vga\", \"std\", \"-display\", \"none\", \"-vnc\", \"127.0.0.1:0\",\n",
        "        \"-drive\", f\"file={storage_path},if=virtio,format=qcow2\",\n",
        "        \"-sandbox\", \"off\", \"-machine\", \"type=pc,accel=kvm:tcg\",\n",
        "        \"-monitor\", \"unix:/tmp/qemu-monitor.sock,server,nowait\"\n",
        "    ]\n",
        "\n",
        "    # Check for UEFI BIOS candidates\n",
        "    for candidate in [\"/usr/share/OVMF/OVMF_CODE.fd\", \"/usr/share/qemu/OVMF.fd\", \"/usr/share/ovmf/OVMF.fd\"]:\n",
        "        if os.path.exists(candidate):\n",
        "            qemu_cmd.extend([\"-bios\", candidate])\n",
        "            break\n",
        "\n",
        "    subprocess.Popen(qemu_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n",
        "    print(\"⏳ Waiting 12 seconds for VM file systems to mount...\")\n",
        "    time.sleep(12)\n",
        "\n",
        "    print(\"\\n=== STEP 5: EXPANDING GUEST LINUX FILESYSTEM ===\")\n",
        "    # Grow the partition boundary and expand the filesystem online inside the guest OS\n",
        "    print(\"Sending live partition expansion commands...\")\n",
        "    send_string_to_vm(\"parted -s /dev/vda resizepart 1 100%\\n\")\n",
        "    time.sleep(2)\n",
        "    send_string_to_vm(\"resize2fs /dev/vda1\\n\")\n",
        "    time.sleep(2)\n",
        "\n",
        "    print(\"\\n=== STEP 6: RETRYING LIGHTWEIGHT GUI INSTALLATION ===\")\n",
        "    print(\"Syncing repositories...\")\n",
        "    send_string_to_vm(\"pacman -Sy\\n\")\n",
