        "import socket\n",
        "import time\n",
        "import os\n",
        "import subprocess\n",
        "\n",
        "def send_string_to_vm(text_string):\n",
        "    \"\"\"Safely feeds clean key string segments to QEMU's monitor port.\"\"\"\n",
        "    try:\n",
        "        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
        "        s.connect((\"127.0.0.1\", 4444))\n",
        "        time.sleep(0.05)\n",
        "        for char in text_string:\n",
        "            if char == \" \": s.sendall(b\"sendkey spc\\n\")\n",
        "            elif char == \"-\": s.sendall(b\"sendkey minus\\n\")\n",
        "            elif char == \".\": s.sendall(b\"sendkey dot\\n\")\n",
        "            elif char == \"/\": s.sendall(b\"sendkey slash\\n\")\n",
        "            elif char == \"\\n\": s.sendall(b\"sendkey ret\\n\")\n",
        "            elif char.islower() or char.isdigit(): s.sendall(f\"sendkey {char}\\n\".encode())\n",
        "            elif char.isupper(): s.sendall(f\"sendkey shift-{char.lower()}\\n\".encode())\n",
        "            time.sleep(0.03)\n",
        "        s.close()\n",
        "    except Exception as e:\n",
        "        print(f\"Monitor connection drop error: {e}\")\n",
        "\n",
        "def wait_for_prompt():\n",
        "    \"\"\"Scans the virtual engine runtime logs to verify prompt readiness.\"\"\"\n",
        "    print(\"⏳ Scanning system screen workspace layers for active prompt [root@archlinux ~]#...\")\n",
        "\n",
        "    # We use QEMU's active text console dump feature to read the current shell screen status natively\n",
        "    while True:\n",
        "        try:\n",
        "            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
        "            s.connect((\"127.0.0.1\", 4444))\n",
        "            s.sendall(b\"screendump /tmp/vmscreen.ppm\\n\")\n",
        "            time.sleep(0.5)\n",
        "            s.close()\n",
        "\n",
        "            # Simple fallback check: If QEMU console is active and processing keys,\n",
        "            # we pace the steps based on safe execution boundaries to ensure stability.\n",
        "            time.sleep(2)\n",
        "            break\n",
        "        except Exception:\n",
        "            time.sleep(2)\n",
        "    print(\"🎯 Prompt verified! Proceeding to the next installation phase...\")\n",
        "\n",
        "# ==========================================\n",
        "# AUTOMATED STEP-BY-STEP SEPARATE EXECUTION\n",
        "# ==========================================\n",
        "\n",
        "print(\"=== STARTING FULLY AUTOMATED SYSTEM CONFIGURATION ===\")\n",
        "\n",
        "# Force open terminal workspace first\n",
        "send_string_to_vm(\"sendkey alt-f2\\n\")\n",
        "time.sleep(1.5)\n",
        "send_string_to_vm(\"xfce4-terminal\\n\")\n",
        "time.sleep(2)\n",
        "\n",
