        "wait_for_prompt()\n",
        "print(\"▶️ Injecting Step 1: Updating system mirror libraries...\")\n",
        "send_string_to_vm(\"echo -e '\\\\n[multilib]\\\\nInclude = /etc/pacman.d/mirrorlist' >> /etc/pacman.conf\\n\")\n",
        "send_string_to_vm(\"pacman -Sy\\n\")\n",
        "time.sleep(10) # Safe network sync window buffer\n",
        "\n",
        "# PHASE 2: Firefox Installation\n",
        "wait_for_prompt()\n",
        "print(\"▶️ Injecting Step 2: Starting separate Firefox installation...\")\n",
        "send_string_to_vm(\"pacman -S firefox --noconfirm\\n\")\n",
        "time.sleep(30) # Wait for package manager transaction finish\n",
        "\n",
        "# PHASE 3: Steam Installation\n",
        "wait_for_prompt()\n",
        "print(\"▶️ Injecting Step 3: Starting separate Steam installation...\")\n",
        "send_string_to_vm(\"pacman -S steam --noconfirm\\n\")\n",
        "time.sleep(45) # Allow internal 32bit file layout streaming\n",
        "\n",
        "# PHASE 4: Sober Installation\n",
        "wait_for_prompt()\n",
        "print(\"▶️ Injecting Step 4: Provisioning Flatpak engine and downloading Sober...\")\n",
        "send_string_to_vm(\"pacman -S flatpak --noconfirm\\n\")\n",
        "time.sleep(10)\n",
        "send_string_to_vm(\"flatpak remote-add --if-not-exists flathub https://flathub.org\\n\")\n",
        "time.sleep(3)\n",
        "send_string_to_vm(\"flatpak install flathub org.vinehq.Sober -y\\n\")\n",
        "time.sleep(30)\n",
        "\n",
        "# PHASE 5: Graphics Interface Tray Sync\n",
        "wait_for_prompt()\n",
        "print(\"▶️ Finalizing: Restarting panel interface tracking...\")\n",
        "send_string_to_vm(\"xfce4-panel --restart\\n\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
