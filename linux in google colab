        "import os\n",
        "import glob\n",
        "import subprocess\n",
        "import time\n",
        "from google.colab import output\n",
        "from google.colab.output import eval_js\n",
        "\n",
        "print(\"=== STEP 1: PURGING SLUGGISH RUNTIMES ===\")\n",
        "!pkill -9 -f qemu\n",
        "!pkill -9 -f websockify\n",
        "!pkill -9 -f Xvnc\n",
        "\n",
        "print(\"\\n=== STEP 2: DYNAMICALLY LOCATING VIRTUAL DISK ===\")\n",
        "!apt-get update -y && apt-get install -y novnc websockify python3-websockify\n",
        "!apt-get update -y && apt-get install -y qemu-system-x86 qemu-utils ovmf novnc websockify python3-websockify\n",
        "\n",
        "os.makedirs(\"/content\", exist_ok=True)\n",
        "storage_path = \"/content/arch_target.qcow2\"\n",
        "iso_path = \"/content/drive/MyDrive/qemu/archlinux-2026.10.01-x86_64.iso\"\n",
        "\n",
        "preferred_path = \"/content/arch_target.qcow2\"\n",
        "fallback_path = \"arch-desktop-flatpak-vbox-2026.03.01-x64.qcow2\"\n",
        "\n",
        "storage_path = \"\"\n",
        "\n",
        "# Auto-detect script to find where your actual disk file is sitting\n",
        "if os.path.exists(preferred_path):\n",
        "    storage_path = preferred_path\n",
        "elif os.path.exists(fallback_path):\n",
        "    storage_path = fallback_path\n",
        "else:\n",
        "    # Scan the workspace for any qcow2 files if names were changed\n",
        "    qcow2_files = glob.glob(\"**/*.qcow2\", recursive=True) + glob.glob(\"*.qcow2\")\n",
        "    if qcow2_files:\n",
        "        storage_path = qcow2_files[0]\n",
        "        print(f\"Auto-detected disk file at: {storage_path}\")\n",
        "\n",
        "if not storage_path:\n",
        "    print(\"❌ CRITICAL ERROR: No .qcow2 virtual disk file found in your Colab workspace!\")\n",
        "    print(\"Please upload your disk file or check your Google Drive mount setup.\")\n",
        "else:\n",
        "    print(f\"✅ Using virtual disk image: {storage_path}\")\n",
        "\n",
        "    print(\"\\n=== STEP 3: DYNAMICALLY LOOKING FOR UEFI FIRMWARE ===\")\n",
        "    uefi_bios_path = \"\"\n",
        "    bios_candidates = [\n",
        "        \"/usr/share/OVMF/OVMF_CODE.fd\",\n",
        "        \"/usr/share/qemu/OVMF.fd\",\n",
        "        \"/usr/share/ovmf/OVMF.fd\",\n",
        "        \"/usr/share/ovmf/x64/OVMF_CODE.fd\"\n",
        "    ]\n",
        "    for candidate in bios_candidates:\n",
        "        if os.path.exists(candidate):\n",
        "            uefi_bios_path = candidate\n",
        "            print(f\"Found UEFI firmware at: {uefi_bios_path}\")\n",
        "            break\n",
        "\n",
        "    print(\"\\n=== STEP 4: INITIALIZING HIGH-SPEED WEBSOCKIFY PROXY ===\")\n",
