        "        \"-sandbox\", \"off\",\n",
        "\n",
        "        # --- THE ACCELERATION FIX: Force native TCG emulation for Colab environments ---\n",
        "        \"-machine\", \"type=pc,accel=tcg\",\n",
        "\n",
        "        \"-monitor\", \"unix:/tmp/qemu-monitor.sock,server,nowait\"\n",
        "    ]\n",
        "\n",
        "    qemu_process = subprocess.Popen(qemu_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n",
        "\n",
        "    # Dynamic verification: Wait for the monitor socket file to actually generate\n",
        "    socket_ready = False\n",
        "    for _ in range(15): # Poll for up to 15 seconds\n",
        "        if os.path.exists(\"/tmp/qemu-monitor.sock\"):\n",
        "            socket_ready = True\n",
        "            break\n",
        "        time.sleep(1)\n",
        "\n",
        "    if qemu_process.poll() is not None or not socket_ready:\n",
        "        print(\"❌ Error: QEMU failed to start or control socket did not initialize. Crash dump:\")\n",
        "        print(qemu_process.stderr.read())\n",
        "    else:\n",
        "        print(\"🚀 Arch Linux Engine deployed successfully with automated string control active!\")\n",
        "        time.sleep(2) # Final buffer ensuring VNC handshake framework is fully stable\n",
