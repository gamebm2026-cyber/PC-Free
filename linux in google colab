        "    print(\"\\n=== STEP 5: RUNNING ACCELERATED 4-CORE QEMU ENGINE ===\")\n",
        "    qemu_cmd = [\n",
        "        \"qemu-system-x86_64\",\n",
        "        \"-m\", \"4G\",\n",
        "        \"-smp\", \"4,sockets=1,cores=4\",\n",
        "        \"-cpu\", \"max\",\n",
        "        \"-cdrom\", iso_path,\n",
        "        \"-vga\", \"std\",\n",
        "        \"-display\", \"none\",\n",
        "        \"-vnc\", \"127.0.0.1:0\",\n",
        "        \"-drive\", f\"file={storage_path},if=virtio,format=qcow2\",\n",
